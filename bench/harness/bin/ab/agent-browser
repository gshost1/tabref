#!/bin/bash
# Arm ab: vercel-labs agent-browser 0.42.0 (npm, --ignore-scripts; the package ships the native binary). It attaches
# to the run's Chrome over CDP (--cdp <port>). Off: the outdated-Chrome CVE check (its only automatic network call).
# Refused: chat (a model inside the tool), upgrade, install (Chrome download), doctor (network probes), dashboard,
# plugin, and cloud providers. Same as the Linux run's /opt/bench/ho-bin/ab/agent-browser (ab-install.sh); only the
# install folder differs.
H=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
P=${BENCH_TOOLS:?}/agent-browser-0.42.0/node_modules/agent-browser
case "$(uname -m)" in
  x86_64) bin=$P/bin/agent-browser-linux-x64 ;;
  aarch64) bin=$P/bin/agent-browser-linux-arm64 ;;
  *) echo "bench wrapper: no agent-browser binary for $(uname -sm)" >&2; exit 2 ;;
esac
export AGENT_BROWSER_NO_VERSION_CHECK=1 AGENT_BROWSER_SKILLS_DIR="$P/skill-data"
unset AI_GATEWAY_API_KEY AI_GATEWAY_URL ANTHROPIC_API_KEY AGENT_BROWSER_PROVIDER AGENT_BROWSER_AUTO_CONNECT
value_flags=" --session --restore-save --restore-check-url --restore-check-text --restore-check-fn --namespace
  --headers --executable-path --cdp --cdp-headers --extension --init-script --enable --profile --state --proxy
  --proxy-bypass --args --user-agent -p --provider --device --session-name --color-scheme --download-path
  --max-output --allowed-domains --capture --action-policy --confirm-actions --config --engine --input-mode
  --screenshot-dir --screenshot-quality --screenshot-format --idle-timeout --ca-cert --model "
value_flags=${value_flags//$'\n'/ }
skip=0 cmd=""
for a in "$@"; do
  if (( skip )); then skip=0; continue; fi
  case $a in
    -p|--provider|--provider=*) echo "bench: cloud browser providers are disabled; use the run's Chrome over --cdp" >&2; exit 64 ;;
    --auto-connect) echo "bench: --auto-connect is disabled; pass --cdp <port>" >&2; exit 64 ;;
    --) break ;;
    -*) [[ "$value_flags" == *" $a "* ]] && skip=1 ;;
    *) cmd=$a; break ;;
  esac
done
case $cmd in
  chat) echo "bench: agent-browser chat is disabled in this benchmark (it runs its own model)" >&2; exit 64 ;;
  upgrade|install|doctor|dashboard|plugin|plugins) echo "bench: $cmd is disabled in this benchmark" >&2; exit 64 ;;
esac
exec "${HO_WRAP:-$H/heldout/linux/wrap.sh}" "$bin" "$@"
